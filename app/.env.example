# Cloud sync. Without these the app runs entirely in the browser, which is a
# supported way to use it — not a broken state.
#
# Both values come from Supabase: Project Settings > API.
# The anon key is meant to be public; row-level security is what protects the
# data. Never put the service_role key here — it bypasses every policy.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
