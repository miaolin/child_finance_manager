# Required. Signing in is the way into the app, and these are what make signing
# in possible: without them there is no account, and so no way past the sign-in
# screen.
#
# Both values come from Supabase: Project Settings > API.
# The anon key is meant to be public; row-level security is what protects the
# data. Never put the service_role key here — it bypasses every policy.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
